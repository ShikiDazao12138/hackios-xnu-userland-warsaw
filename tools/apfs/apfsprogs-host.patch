+	msb_raw = apfs_mmap(NULL, bsize_tmp, PROT_READ, MAP_PRIVATE,
+		       APFS_NX_BLOCK_NUM * bsize_tmp);
 	if (msb_raw == MAP_FAILED)
 		system_error();
 
@@ -89,8 +89,8 @@ static struct apfs_nx_superblock *read_super_copy(void)
 	if (sb->s_blocksize != bsize_tmp) {
 		munmap(msb_raw, bsize_tmp);
 
-		msb_raw = mmap(NULL, sb->s_blocksize, PROT_READ, MAP_PRIVATE,
-			       fd_main, APFS_NX_BLOCK_NUM * sb->s_blocksize);
+		msb_raw = apfs_mmap(NULL, sb->s_blocksize, PROT_READ, MAP_PRIVATE,
+			       APFS_NX_BLOCK_NUM * sb->s_blocksize);
 		if (msb_raw == MAP_FAILED)
 			system_error();
 	}
@@ -119,8 +119,8 @@ static struct apfs_nx_superblock *read_latest_super(u64 base, u32 blocks)
 	for (bno = base; bno < base + blocks; ++bno) {
 		struct apfs_nx_superblock *current;
 
-		current = mmap(NULL, sb->s_blocksize, PROT_READ, MAP_PRIVATE,
-			       fd_main, bno * sb->s_blocksize);
+		current = apfs_mmap(NULL, sb->s_blocksize, PROT_READ, MAP_PRIVATE,
+			       bno * sb->s_blocksize);
 		if (current == MAP_FAILED)
 			system_error();
 
