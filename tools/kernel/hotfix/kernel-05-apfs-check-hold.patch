@@ -309,10 +309,12 @@ apfs_check_thread(void *arg, __unused wait_result_t wr)
 	/* the modes that write: no walk, no mount, no census */
 	if (mode == 7) {
 		apfs_write_check(devname);
+		apfs_hold_if_asked();
 		return;
 	}
 	if (mode == 8) {
 		apfs_store_check(devname);
+		apfs_hold_if_asked();
 		return;
 	}
 
@@ -607,10 +609,33 @@ apfs_volume_mount(void)
 	}
 }
 
+/*
+ * apfs_hold=1 keeps the processor here after a write or store check instead of letting it run on.
+ *
+ * Why: on this machine the "kernel hands itself back to the loader" path faults (mode 6, which writes
+ * nothing at all, faults exactly the same way), and the loader resets its log when it takes over --
+ * so a check that returns leaves no verdict to read. Holding instead keeps the console log, with the
+ * check's own lines in it, available to be sampled over fastboot.
+ */
+static void
+apfs_hold_if_asked(void)
+{
+	uint32_t hold = 0;
+	uint32_t n = 0;
+
+	if (!PE_parse_boot_argn("apfs_hold", &hold, sizeof(hold)) || hold == 0) {
+		return;
+	}
+	printf("apfs-check: holding here: apfs_hold=1, the log above is the whole result\n");
+	for (;;) {
+		delay(5000000);
+		printf("apfs-check: still holding (%u)\n", ++n);
+	}
+}
+
 void
 annibale_apfs_check_init(void)
