diff --git a/merge/xnu/files/bsd/dev/annibale/annibale_apfs_check.c b/merge/xnu/files/bsd/dev/annibale/annibale_apfs_check.c
index a21cfe0..1f972c4 100644
--- a/merge/xnu/files/bsd/dev/annibale/annibale_apfs_check.c
+++ b/merge/xnu/files/bsd/dev/annibale/annibale_apfs_check.c
@@ -268,6 +268,31 @@ apfs_check_concurrent(void)
 	printf("apfs-check: readers that disagreed or failed: %d\n", bad);
 	apfs_stats_print();
 }
+/*
+ * apfs_hold=1 keeps the processor here after a write or store check instead of letting it run on.
+ *
+ * Why: on this machine the "kernel hands itself back to the loader" path faults (mode 6, which writes
+ * nothing at all, faults exactly the same way), and the loader resets its log when it takes over --
+ * so a check that returns leaves no verdict to read. Holding instead keeps the console log, with the
+ * check's own lines in it, available to be sampled over fastboot.
+ */
+static void
+apfs_hold_if_asked(void)
+{
+	uint32_t hold = 0;
+	uint32_t n = 0;
+
+	if (!PE_parse_boot_argn("apfs_hold", &hold, sizeof(hold)) || hold == 0) {
+		return;
+	}
+	printf("apfs-check: holding here: apfs_hold=1, the log above is the whole result\n");
+	for (;;) {
+		delay(5000000);
+		/* the console scrolls: repeat the write check's own verdict so it can be read at any time */
+		printf("apfs-check: still holding (%u): %s\n", ++n, apfs_write_verdict);
+	}
+}
+
 
 static void
 apfs_check_thread(void *arg, __unused wait_result_t wr)
@@ -309,10 +334,12 @@ apfs_check_thread(void *arg, __unused wait_result_t wr)
 	/* the modes that write: no walk, no mount, no census */
 	if (mode == 7) {
 		apfs_write_check(devname);
+		apfs_hold_if_asked();
 		return;
 	}
 	if (mode == 8) {
 		apfs_store_check(devname);
+		apfs_hold_if_asked();
 		return;
 	}
 
@@ -609,8 +636,7 @@ apfs_volume_mount(void)
 
