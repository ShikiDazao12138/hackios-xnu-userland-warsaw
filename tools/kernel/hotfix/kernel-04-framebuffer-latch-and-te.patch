+/*
+ * How finely the latch is watched, and how long it is waited for. IOSleep(1) is the coarsest step a
+ * sleeping wait can take, and the latch can happen anywhere inside it: the frame then starts up to
+ * 1 ms late and flip.taken records a time up to 1 ms after the refresh that actually took it, which
+ * is the "C" segment our measurements show sitting at one whole beat. fb_latch_poll_us=200 spins in
+ * 200 us steps instead (a busy wait, so it costs the presenter's processor), and fb_latch_us bounds
+ * the whole wait: a frame that cannot be taken inside that window is given up on at once rather than
+ * holding the next frame back for 40 ms.
+ */
+static TUNABLE(uint32_t, gLatchPoll, "fb_latch_poll_us", 1000);
+static TUNABLE(uint32_t, gLatchWait, "fb_latch_us", 40000);
+
+/*
+ * The panel's tear signal (GPIO_86) is wired to mdss_mdp's SPI 115, and nothing in this tree has ever
+ * attached it: the beat is inferred by polling CTL_FLUSH, so a frame starts up to a millisecond late
+ * and the wait has to be bounded by hand. With fb_te=1 the tear interrupt is enabled on the active
+ * INTF, attached, and the latch wait sleeps until it arrives instead of polling; the flush bit stays
+ * authoritative, and a wait that sees no tear inside fb_latch_us falls back to the polling loop, so a
+ * register that turns out not to enable anything costs a slower frame, not a black panel.
+ *
+ * Offsets are mainline's (disp/dpu1/dpu_hw_intf.h), the ones this file's other INTF writes use:
+ * INTF_TEAR_INT_EN 0x2a0, INTF_TEAR_INT_STATUS 0x2a4, INTF_TEAR_INT_COUNT_VAL 0x298.
+ */
+static TUNABLE(uint32_t, gTE, "fb_te", 0);
+
 /* Until CTL has taken the last flush (its bits clear at the refresh that latches them), LIMIT_US at most. */
 static bool
 flip_taken(uint32_t limit_us, bool may_sleep)
 {
+	uint32_t poll = gLatchPoll < 50 ? 50 : (gLatchPoll > 10000 ? 10000 : gLatchPoll);
+
+	if (limit_us > gLatchWait) {
+		limit_us = gLatchWait;
+	}
 	flip.taken_valid = false;
-	for (uint32_t waited = 0; waited < limit_us; waited += may_sleep && waited >= 200 ? 1000 : 50) {
+	/*
+	 * With the tear interrupt attached, sleep on it instead of polling: the panel wakes us at the
+	 * refresh that takes the flush, so there is no 1 ms quantisation and no busy wait. The flush bit
+	 * stays the authority -- a wakeup only says a refresh happened -- and anything unexpected (no
+	 * tear inside the window, a wait that returns early) drops through to the polling loop below, so
+	 * a register that enables nothing costs one slow frame rather than a hung presenter.
+	 */
+	if (flip.te_on && may_sleep && flip.te_lock != NULL) {
+		uint64_t ticks, deadline = mach_absolute_time();
+
+		nanoseconds_to_absolutetime((uint64_t) limit_us * 1000ULL, &ticks);
+		deadline += ticks;
+		while (mach_absolute_time() < deadline) {
+			if ((flip_rd(FLIP_CTL(flip.ctl) + FLIP_CTL_FLUSH) & flip.flush) == 0) {
+				flip_note_taken();
+				return true;
+			}
+			IOLockLock(flip.te_lock);
+			IOLockSleepDeadline(flip.te_lock, &flip.te_seq, deadline, THREAD_UNINT);
+			IOLockUnlock(flip.te_lock);
+		}
+		if ((flip_rd(FLIP_CTL(flip.ctl) + FLIP_CTL_FLUSH) & flip.flush) == 0) {
+			flip_note_taken();
+			return true;
+		}
+	}
+	for (uint32_t waited = 0; waited < limit_us; waited += poll) {
 		if ((flip_rd(FLIP_CTL(flip.ctl) + FLIP_CTL_FLUSH) & flip.flush) == 0) {
 			flip_note_taken();
 			return true;
 		}
-		if (may_sleep && waited >= 200) {
-			IOSleep(1);
+		/* A step of 200 us or less is spun on: it is the difference between a frame landing in this
+		 * refresh and the next one. Longer steps sleep, which needs whole milliseconds. */
+		if (!may_sleep || poll <= 200) {
+			delay(poll);
 		} else {
-			delay(50);
+			IOSleep(poll / 1000 > 0 ? poll / 1000 : 1);
 		}
 	}
 	if ((flip_rd(FLIP_CTL(flip.ctl) + FLIP_CTL_FLUSH) & flip.flush) == 0) {
