+static void
+flip_te_intr(void * context, uint32_t intid)
+{
+	uint32_t status = flip_rd(flip.te_at + FLIP_INTF_TEAR_INT_STATUS);
+
+	(void) context;
+	(void) intid;
+	/*
+	 * The status bits are write-1-to-clear. The first version of this did not clear them, so the line
+	 * stayed asserted and the GIC redelivered the same tear: an interrupt storm that took the frame
+	 * rate from 23.8% dropped to 90.3% dropped. Clearing is not a courtesy here, it is the feature.
+	 */
+	if (status == 0) {
+		return;
+	}
+	flip_wr(flip.te_at + FLIP_INTF_TEAR_INT_STATUS, status);
+	flip.te_count++;
+	flip.te_last = mach_absolute_time();
+	/* Only a frame actually waiting for the latch has anything to gain from a wakeup. */
+	if (flip.pending && flip.te_lock != NULL) {
+		flip.te_seq++;
+		IOLockWakeup(flip.te_lock, &flip.te_seq, false);
+	}
+}
