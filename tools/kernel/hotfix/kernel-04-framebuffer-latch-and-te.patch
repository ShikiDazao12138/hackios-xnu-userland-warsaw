+/*
+ * Turn the tear interrupt on for the INTF the panel is driven from. Runs after flip.pipes/ctl/intf are
+ * known, so the register written is the one the display actually uses. fb_te=1 only.
+ */
+static void
+flip_te_enable(void)
+{
+	uint32_t at = FLIP_INTF(flip.intf);
+
+	flip.te_at = at;
+	flip.te_lock = IOLockAlloc();
+	if (flip.te_lock == NULL) {
+		printf("MiniIOMobileFramebuffer: te: no lock, staying on the polling latch\n");
+		return;
+	}
+	IOLockLock(flip.te_lock);
+	flip.te_seq++;
+	IOLockUnlock(flip.te_lock);
+	/* the count first, then the enable: a tear that arrives inside this frame is still seen */
+	uint32_t before = flip_rd(at + FLIP_INTF_TEAR_COUNT);
+	/* anything already latched belongs to the loader's frames: drop it before the line is enabled */
+	uint32_t stale = flip_rd(at + FLIP_INTF_TEAR_INT_STATUS);
+	if (stale != 0) {
+		flip_wr(at + FLIP_INTF_TEAR_INT_STATUS, stale);
+	}
+	flip_wr(at + FLIP_INTF_TEAR_INT_EN, 1);
+	if (gic_v3_spi_attach(FLIP_TE_INTID, false, flip_te_intr, NULL) != KERN_SUCCESS) {
+		flip_wr(at + FLIP_INTF_TEAR_INT_EN, 0);
+		printf("MiniIOMobileFramebuffer: te: SPI %u not attached, staying on the polling latch\n",
+		    FLIP_TE_INTID);
+		return;
+	}
+	flip.te_on = true;
+	printf("MiniIOMobileFramebuffer: te: intf%u tear int en %08x status %08x count %u -> %u; SPI %u attached\n",
+	    flip.intf, flip_rd(at + FLIP_INTF_TEAR_INT_EN), flip_rd(at + FLIP_INTF_TEAR_INT_STATUS),
+	    before, flip_rd(at + FLIP_INTF_TEAR_COUNT), FLIP_TE_INTID);
+}
